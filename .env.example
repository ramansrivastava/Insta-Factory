# Copy to .env and fill in. Never commit a populated .env.

# Anthropic API key. Leave blank to run entirely on the deterministic mock
# provider — the build, tests, smoke test and Layer-1 eval all pass without it.
ANTHROPIC_API_KEY=

# Which LLM adapter to use: "anthropic" | "mock".
# Defaults to "mock" whenever ANTHROPIC_API_KEY is absent.
LLM_PROVIDER=mock

# Model used by the anthropic adapter.
LLM_MODEL=claude-sonnet-5

# Model the Layer-2 judge grades with (`npm run eval -- --with-judge`).
# Deliberately separate from LLM_MODEL: a model grading its own output marks
# its own phrasing up, and nothing in the score says so. Keep these different.
JUDGE_MODEL=claude-opus-5
